HOST=0.0.0.0
PORT=1337
NODE_ENV=production
APP_KEYS=replace-with-key-1,replace-with-key-2,replace-with-key-3,replace-with-key-4
API_TOKEN_SALT=replace-with-api-token-salt
ADMIN_JWT_SECRET=replace-with-admin-jwt-secret
JWT_SECRET=replace-with-jwt-secret
TRANSFER_TOKEN_SALT=replace-with-transfer-token-salt
DATABASE_CLIENT=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=raushni_cms
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false
PUBLIC_URL=http://localhost:1337
ADMIN_URL=http://localhost:1337/admin
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:1337,http://localhost:3000,http://localhost:3001

# Optional S3-compatible uploads (Railway Buckets / Cloudflare R2).
# Leave AWS_BUCKET empty to use local ./public/uploads.
# AWS_BUCKET=raushni-cms-uploads
# AWS_ACCESS_KEY_ID=
# AWS_ACCESS_SECRET=
# AWS_REGION=auto
# AWS_ENDPOINT=https://storage.railway.app
# AWS_FORCE_PATH_STYLE=true
# AWS_BASE_URL=
# AWS_ROOT_PATH=cms
# AWS_ACL=
# UPLOAD_CSP_ORIGINS=https://*.railway.app,https://*.r2.dev
