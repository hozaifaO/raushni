{
  "kind": "collectionType",
  "collectionName": "donation_payment_settings",
  "info": {
    "singularName": "donation-payment-setting",
    "pluralName": "donation-payment-settings",
    "displayName": "Donation Payment Setting",
    "description": "CMS-managed donation payment methods, UPI details, and QR code configuration"
  },
  "options": {
    "draftAndPublish": false,
    "populateCreatorFields": true
  },
  "attributes": {
    "tenantSlug": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "intro": {
      "type": "text",
      "required": true
    },
    "upiId": {
      "type": "string"
    },
    "qrImage": {
      "type": "media",
      "allowedTypes": ["images"],
      "multiple": false
    },
    "qrImageUrl": {
      "type": "string"
    },
    "accountName": {
      "type": "string",
      "required": true
    },
    "paymentOptions": {
      "type": "json",
      "required": true
    },
    "instructions": {
      "type": "json"
    },
    "supportContact": {
      "type": "string"
    }
  }
}
