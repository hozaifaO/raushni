{
  "kind": "collectionType",
  "collectionName": "beneficiaries",
  "info": {
    "singularName": "beneficiary",
    "pluralName": "beneficiaries",
    "displayName": "Beneficiary",
    "description": "People and families supported by Raushni programs"
  },
  "options": {
    "draftAndPublish": false,
    "populateCreatorFields": true
  },
  "attributes": {
    "beneficiaryId": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "address": {
      "type": "text"
    },
    "program": {
      "type": "string"
    },
    "supportType": {
      "type": "enumeration",
      "enum": ["EDUCATION", "HEALTH", "FINANCIAL", "FOOD", "SHELTER", "OTHER"],
      "default": "EDUCATION"
    },
    "status": {
      "type": "enumeration",
      "enum": ["ACTIVE", "INACTIVE", "COMPLETED"],
      "default": "ACTIVE"
    },
    "enrolledAt": {
      "type": "date"
    },
    "notes": {
      "type": "richtext"
    }
  }
}
