{
  "kind": "collectionType",
  "collectionName": "activities",
  "info": {
    "singularName": "activity",
    "pluralName": "activities",
    "displayName": "Activity",
    "description": "Program activities, field updates, and community work"
  },
  "options": {
    "draftAndPublish": true,
    "populateCreatorFields": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "summary": {
      "type": "text",
      "maxLength": 300
    },
    "content": {
      "type": "richtext"
    },
    "activityDate": {
      "type": "date"
    },
    "location": {
      "type": "string"
    },
    "category": {
      "type": "enumeration",
      "enum": ["EDUCATION", "HEALTH", "RELIEF", "AWARENESS", "COMMUNITY", "OTHER"],
      "default": "COMMUNITY"
    },
    "featuredImage": {
      "type": "media",
      "allowedTypes": ["images"]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images", "videos"]
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
