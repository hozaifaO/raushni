{
  "kind": "collectionType",
  "collectionName": "expenses",
  "info": {
    "singularName": "expense",
    "pluralName": "expenses",
    "displayName": "Expense",
    "description": "Operational and program expenses"
  },
  "options": {
    "draftAndPublish": false,
    "populateCreatorFields": true
  },
  "attributes": {
    "expenseNumber": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "amount": {
      "type": "decimal",
      "required": true
    },
    "currency": {
      "type": "string",
      "default": "INR"
    },
    "category": {
      "type": "enumeration",
      "enum": ["PROGRAM", "ADMIN", "TRAVEL", "SUPPLIES", "SALARY", "OTHER"],
      "default": "PROGRAM"
    },
    "expenseDate": {
      "type": "date",
      "required": true
    },
    "vendor": {
      "type": "string"
    },
    "notes": {
      "type": "text"
    },
    "attachment": {
      "type": "media",
      "allowedTypes": ["files", "images"]
    }
  }
}
