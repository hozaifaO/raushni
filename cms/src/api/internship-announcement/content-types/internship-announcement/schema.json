{
  "kind": "collectionType",
  "collectionName": "internship_announcements",
  "info": {
    "singularName": "internship-announcement",
    "pluralName": "internship-announcements",
    "displayName": "Internship Announcement",
    "description": "Public and dashboard-managed internship announcement content"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "summary": { "type": "text", "required": true },
    "description": { "type": "text", "required": true },
    "startDate": { "type": "date" },
    "endDate": { "type": "date" },
    "registrationDeadline": { "type": "date" },
    "eventDate": { "type": "date" },
    "eventTime": { "type": "string" },
    "location": { "type": "string" },
    "mode": { "type": "enumeration", "enum": ["virtual", "hybrid", "in_person"], "default": "virtual" },
    "status": { "type": "enumeration", "enum": ["draft", "published", "closed"], "default": "published" },
    "poster": { "type": "media", "allowedTypes": ["images"] },
    "posterUrl": { "type": "string" },
    "applyUrl": { "type": "string" },
    "githubUrl": { "type": "string" },
    "contactPhone": { "type": "string" },
    "benefits": { "type": "json" },
    "tracks": { "type": "json" },
    "eligibility": { "type": "json" }
  }
}
