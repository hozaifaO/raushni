# Raushni platform
NODE_ENV=production
ENVIRONMENT=production

# Public URLs
APP_PUBLIC_URL=https://raushni.com
API_PUBLIC_URL=https://api.raushni.com
CMS_PUBLIC_URL=https://cms.raushni.com
CMS_CORS_ORIGINS=https://raushni.com,https://www.raushni.com,http://localhost:3000,http://localhost:3001

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-password
BACKEND_DATABASE_URL=postgresql://postgres:change-this-postgres-password@postgres:5432/raushni_backend
CMS_DATABASE_NAME=raushni_cms
CMS_DATABASE_USERNAME=postgres
CMS_DATABASE_PASSWORD=change-this-postgres-password

# Redis
REDIS_URL=redis://redis:6379

# Strapi production secrets
# Generate with: openssl rand -base64 32
STRAPI_APP_KEYS=key-one,key-two,key-three,key-four
STRAPI_API_TOKEN_SALT=change-this-api-token-salt
STRAPI_ADMIN_JWT_SECRET=change-this-admin-jwt-secret
STRAPI_JWT_SECRET=change-this-jwt-secret
STRAPI_TRANSFER_TOKEN_SALT=change-this-transfer-token-salt

# Frontend
NEXT_PUBLIC_API_URL=https://api.raushni.com
NEXT_PUBLIC_CMS_URL=https://cms.raushni.com
NEXTAUTH_URL=https://raushni.com
NEXTAUTH_SECRET=change-this-nextauth-secret
