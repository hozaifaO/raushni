{
  "kind": "collectionType",
  "collectionName": "news",
  "info": {
    "singularName": "news",
    "pluralName": "news",
    "displayName": "News",
    "description": "News and updates"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "content": {
      "type": "richtext",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "publishedDate": {
      "type": "date"
    },
    "image": {
      "type": "media",
      "allowedTypes": ["images"]
    },
    "status": {
      "type": "enumeration",
      "enum": ["DRAFT", "PUBLISHED"],
      "default": "DRAFT"
    }
  }
}
