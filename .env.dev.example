# Raushni development/staging environment
NODE_ENV=development
ENVIRONMENT=development
DD_ENV=development
DD_VERSION=dev

# Public development URLs
APP_PUBLIC_URL=https://raushni-dev.com
API_PUBLIC_URL=https://api.raushni-dev.com
CMS_PUBLIC_URL=https://cms.raushni-dev.com
CMS_CORS_ORIGINS=https://raushni-dev.com,https://www.raushni-dev.com,https://api.raushni-dev.com,https://cms.raushni-dev.com,http://localhost,http://localhost:3000,http://localhost:1337
STRAPI_ADMIN_URL=https://cms.raushni-dev.com/admin

# Local Docker defaults
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
BACKEND_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/raushni_backend
CMS_DATABASE_NAME=raushni_cms
CMS_DATABASE_USERNAME=postgres
CMS_DATABASE_PASSWORD=postgres
REDIS_URL=redis://redis:6379

# Frontend
NEXT_PUBLIC_API_URL=https://api.raushni-dev.com
NEXT_PUBLIC_CMS_URL=https://cms.raushni-dev.com
NEXT_PUBLIC_REQUIRE_AUTH=false
NEXTAUTH_URL=https://raushni-dev.com
NEXTAUTH_SECRET=replace-with-dev-nextauth-secret
NEXTAUTH_ADMIN_EMAIL=admin@raushni.com
NEXTAUTH_ADMIN_PASSWORD=ChangeMe@12345
NEXTAUTH_STAFF_EMAIL=staff@raushni.com
NEXTAUTH_STAFF_PASSWORD=ChangeMe@12345
REQUIRE_AUTH=false

# Strapi development secrets
STRAPI_APP_KEYS=devKeyA1234567890abcdefghijklmnopqrstuvwxyz,devKeyB1234567890abcdefghijklmnopqrstuvwxyz
STRAPI_API_TOKEN_SALT=dev-api-token-salt-change-me
STRAPI_ADMIN_JWT_SECRET=dev-admin-jwt-secret-change-me
STRAPI_JWT_SECRET=dev-jwt-secret-change-me
STRAPI_TRANSFER_TOKEN_SALT=dev-transfer-token-salt-change-me

# Stripe development placeholders
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Monitoring is off by default for dev.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
DD_API_KEY=
DD_SITE=datadoghq.com
