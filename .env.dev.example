# Raushni local Docker environment (browser uses localhost — no hosts file needed)
# For staging-like named hosts (raushni-dev.com), use k8s nonprod overlays + hosts/DNS.
NODE_ENV=development
ENVIRONMENT=development
DD_ENV=development
DD_VERSION=dev

# Public local URLs (direct container ports; optional TLS via https://localhost nginx)
APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
CMS_PUBLIC_URL=http://localhost:1337
CMS_CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:1337,https://localhost
STRAPI_ADMIN_URL=http://localhost:1337/admin

# Local Docker defaults
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
BACKEND_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/raushni_backend
CMS_DATABASE_NAME=raushni_cms
CMS_DATABASE_USERNAME=postgres
CMS_DATABASE_PASSWORD=postgres
REDIS_URL=redis://redis:6379
ALEMBIC_AUTO_UPGRADE=true
REDIS_CACHE_TTL_SECONDS=60

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CMS_URL=http://localhost:1337
NEXT_PUBLIC_REQUIRE_AUTH=false
DEFAULT_TENANT_SLUG=raushni
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=raushni
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-dev-nextauth-secret
NEXTAUTH_ADMIN_EMAIL=admin@raushni.com
NEXTAUTH_ADMIN_PASSWORD=ChangeMe@12345
NEXTAUTH_STAFF_EMAIL=staff@raushni.com
NEXTAUTH_STAFF_PASSWORD=ChangeMe@12345
REQUIRE_AUTH=false
INTERNAL_API_KEY=dev-internal-api-key-change-me-32chars
CMS_API_TOKEN=dev-cms-api-token-change-me-32charsxx
API_INTERNAL_URL=http://backend:8000
CMS_INTERNAL_URL=http://strapi:1337

# Strapi development secrets
STRAPI_APP_KEYS=devKeyA1234567890abcdefghijklmnopqrstuvwxyz,devKeyB1234567890abcdefghijklmnopqrstuvwxyz
STRAPI_API_TOKEN_SALT=dev-api-token-salt-change-me
STRAPI_ADMIN_JWT_SECRET=dev-admin-jwt-secret-change-me
STRAPI_JWT_SECRET=dev-jwt-secret-change-me
STRAPI_TRANSFER_TOKEN_SALT=dev-transfer-token-salt-change-me

# Stripe development placeholders
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional monitoring (compose profile: monitoring)
DD_API_KEY=
DD_SITE=datadoghq.com
DD_HOSTNAME=raushni-docker
OTEL_SDK_DISABLED=true
